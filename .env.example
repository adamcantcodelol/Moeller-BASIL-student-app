# No provider secrets are required for core scientific modules.
# Do not put API keys in NEXT_PUBLIC_ variables.

# Optional ShannonBot free-tier LLM (Phase 7). Local Socratic mode works without these.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# SHANNONBOT_API_KEY=

# Optional: only used by drizzle-kit remote D1 commands (not required for local dev).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DATABASE_ID=
# CLOUDFLARE_D1_TOKEN=
