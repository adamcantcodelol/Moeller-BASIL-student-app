# Core scientific modules need no paid API keys.
# Never put secrets in NEXT_PUBLIC_* variables.

# Optional ShannonBot free-tier LLM (server-side only). Local Socratic mode works without these.
# Prefer Groq; OpenRouter is an alternate. SHANNONBOT_API_KEY is accepted as a Groq alias.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# SHANNONBOT_API_KEY=
# Optional provider preference: groq | openrouter
# SHANNONBOT_PROVIDER=groq
# Optional model overrides
# GROQ_MODEL=llama-3.1-8b-instant
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# SHANNONBOT_MODEL=

# Optional: only used by drizzle-kit remote D1 commands (not required for local dev).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DATABASE_ID=
# CLOUDFLARE_D1_TOKEN=
